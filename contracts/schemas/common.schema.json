{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://youtubeshuffle.local/schemas/common.schema.json",
  "title": "NeoAres common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "sourceId", "url"],
      "properties": {
        "provider": { "const": "YOUTUBE" },
        "sourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "analysisRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysisId", "trackId", "fingerprint", "algorithmVersion"],
      "properties": {
        "analysisId": { "$ref": "#/$defs/uuid" },
        "trackId": { "$ref": "#/$defs/uuid" },
        "fingerprint": { "type": "string", "minLength": 16 },
        "algorithmVersion": { "type": "string", "minLength": 1 }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable",
        "severity",
        "component",
        "context",
        "causeCode",
        "occurredAt"
      ],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "severity": {
          "enum": ["INFO", "WARNING", "ERROR", "FATAL"]
        },
        "component": { "type": "string", "minLength": 1 },
        "context": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          }
        },
        "causeCode": { "type": ["string", "null"] },
        "occurredAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "energyPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "energy"],
      "properties": {
        "at": { "type": "number", "minimum": 0, "maximum": 1 },
        "energy": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startSeconds", "endSeconds"],
      "properties": {
        "startSeconds": { "type": "number", "minimum": 0 },
        "endSeconds": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}

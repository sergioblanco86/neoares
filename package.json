{
  "name": "neoares",
  "productName": "NeoAres",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DJ privado de escritorio con curaduría y mezcla local desde un catálogo musical en línea.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "setup:media": "python3 -m venv .tools/venv && .tools/venv/bin/python -m pip install --disable-pip-version-check yt-dlp",
    "dev": "concurrently -k -n renderer,main,desktop -c cyan,magenta,green \"pnpm dev:renderer\" \"pnpm dev:main\" \"pnpm dev:desktop\"",
    "dev:renderer": "vite",
    "dev:main": "pnpm build:electron --watch",
    "dev:desktop": "wait-on http://127.0.0.1:5173 dist-electron/main.cjs && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outdir=dist-electron --out-extension:.js=.cjs",
    "build": "rimraf dist dist-electron && pnpm build:electron && vite build",
    "package:mac": "pnpm build && bash scripts/package-macos.sh",
    "package:win": "pnpm build && bash scripts/package-windows.sh",
    "package:all": "pnpm build && bash scripts/package-macos.sh && bash scripts/package-windows.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "start": "pnpm build && electron ."
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "youtubei.js": "18.0.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.4.3",
    "esbuild": "0.28.2",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wait-on": "9.1.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
